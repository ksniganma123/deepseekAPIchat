<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all visuals; this theme only removes the platform action bar
         and keeps the window background transparent-safe for edge-to-edge drawing. -->
    <style name="Theme.MultipromptChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
